# Authentication
NEXTAUTH_SECRET=your-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# TiDB Database (TiDB Cloud recommended for production)
#
# IMPORTANT for production deployments (Vercel, etc.):
#   TiDB Cloud clusters have an IP allowlist. By default, only the IPs you
#   manually add can connect. Your serverless functions will connect from
#   Vercel's egress IPs, which are NOT on the allowlist by default. Either:
#     (a) TiDB Cloud console → Cluster → Security → IP Allowlist → Add
#         "0.0.0.0/0"  (allow from anywhere), OR
#     (b) Add the specific Vercel region IPs you deploy to.
#   Without this, /api/health will return 503 and the app will fail on every
#   database query with a TLS/connection error.
TIDB_HOST=your-tidb-host
TIDB_PORT=4000
TIDB_USER=your-tidb-user
TIDB_PASSWORD=your-tidb-password
TIDB_DATABASE=indflow

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (email)
RESEND_API_KEY=

# Monitoring
SENTRY_DSN=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
